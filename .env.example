# Banco de dados PostgreSQL
POSTGRES_USER=atende
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=atende_cloud_corp
DATABASE_URL=postgresql://atende:change_me_strong_password@postgres:5432/atende_cloud_corp?schema=public

# Auth.js (NextAuth v5)
NEXTAUTH_SECRET=change_me_generate_with_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost:3000

# Usuário administrador criado pelo seed inicial
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@atende.local
SEED_ADMIN_PASSWORD=admin123

# Porta exposta da aplicação
APP_PORT=3000

# SMTP (envio de e-mails de notificação do módulo de Frota)
# Deixe em branco para desabilitar o envio de e-mails (a aplicação funciona normalmente sem SMTP configurado).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=notificacoes@atende.local
SMTP_SECURE=false

# E-mail(s) que recebem as notificações de frota (separados por vírgula)
FROTA_NOTIFICATION_EMAILS=
