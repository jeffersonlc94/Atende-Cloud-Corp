// Atende Cloud Corp - Prisma schema
// Sistema self-hosted, single-tenant

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum Cargo {
  TECNICO
  VENDEDOR
}

model User {
  id                        String   @id @default(cuid())
  name                      String
  email                     String   @unique
  passwordHash              String
  role                      Role     @default(USER)
  cargo                     Cargo?
  avatarUrl                 String?
  canAccessOrcamentos       Boolean  @default(true)
  canAccessFrota            Boolean  @default(true)
  receiveNotifications      Boolean  @default(true)
  canAccessEstoque          Boolean  @default(true)
  canAccessTreinamentos     Boolean  @default(true)
  canAccessCotacoes         Boolean  @default(true)
  canAccessArquivosTecnicos Boolean  @default(true)
  telegramChatId            String?
  hidden                    Boolean  @default(false)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  quotes                    Quote[]
  quoteDrafts               QuoteDraft[]
  trainingContents          TrainingContent[]
  technicalFiles            TechnicalFile[]
  presence                  UserPresence?
  updatedQuotes             Quote[]             @relation("QuoteUpdatedBy")
  mileageLogs               MileageLog[]
  checklists                Checklist[]
  maintenances              Maintenance[]
  auditLogs                 AuditLog[]
  supplierQuotations        SupplierQuotation[] @relation("SupplierQuotationCreatedBy")
  updatedSupplierQuotations SupplierQuotation[] @relation("SupplierQuotationUpdatedBy")

  @@map("users")
}

model Company {
  id                String   @id @default(cuid())
  razaoSocial       String
  nomeFantasia      String?
  cnpj              String?
  inscricaoEstadual String?
  endereco          String?
  cidade            String?
  estado            String?
  cep               String?
  telefone1         String?
  telefone2         String?
  email             String?
  site              String?
  logoUrl           String?
  nomeResponsavel   String?
  isDefault         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  quotes             Quote[]
  supplierQuotations SupplierQuotation[]
  vehicles           Vehicle[]

  @@map("companies")
}

model Client {
  id        String   @id @default(cuid())
  nome      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotes Quote[]

  @@map("clients")
}

enum Visibilidade {
  Global
  Privado
}

enum DescontoTipo {
  Valor
  Percentual
}

enum TipoItem {
  Produto
  Servico
}

enum QuoteStatus {
  Negociacao
  Enviado
  NaoAprovado
  Aprovado
}

model Quote {
  id                    String        @id @default(cuid())
  numero                String        @unique
  companyId             String
  company               Company       @relation(fields: [companyId], references: [id])
  clientId              String
  client                Client        @relation(fields: [clientId], references: [id])
  referencia            String?
  dataEmissao           DateTime      @default(now())
  dataValidade          DateTime?
  validadeDias          Int?
  condicoesPagamento    String?
  prazoEntrega          String?
  observacoes           String?
  observacoesInternas   String?
  fotosInternas         Json          @default("[]")
  subtotal              Decimal?      @db.Decimal(14, 2)
  descontoGeralTipo     DescontoTipo?
  descontoGeralValor    Decimal?      @db.Decimal(14, 2)
  descontoProdutosTipo  DescontoTipo?
  descontoProdutosValor Decimal?      @db.Decimal(14, 2)
  descontoServicosTipo  DescontoTipo?
  descontoServicosValor Decimal?      @db.Decimal(14, 2)
  total                 Decimal       @default(0) @db.Decimal(14, 2)
  status                QuoteStatus   @default(Negociacao)
  visibilidade          Visibilidade  @default(Global)
  createdByUserId       String?
  createdByUser         User?         @relation(fields: [createdByUserId], references: [id])
  updatedByUserId       String?
  updatedByUser         User?         @relation("QuoteUpdatedBy", fields: [updatedByUserId], references: [id])
  sourceDraftId         String?       @unique
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  itens QuoteItem[]

  @@map("quotes")
}

model QuoteDraft {
  id              String   @id @default(cuid())
  data            Json     @default("{}")
  autoSave        Boolean  @default(true)
  createdByUserId String
  createdByUser   User     @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([createdByUserId, updatedAt])
  @@map("quote_drafts")
}

enum TrainingContentType {
  Videoaula
  Documento
}

model TrainingCategory {
  id        String            @id @default(cuid())
  nome      String            @unique
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  contents  TrainingContent[]

  @@map("training_categories")
}

model TrainingContent {
  id              String              @id @default(cuid())
  titulo          String
  descricao       String?
  tipo            TrainingContentType
  arquivoUrl      String
  capaUrl         String?
  nomeArquivo     String?
  ordem           Int                 @default(0)
  categoryId      String
  category        TrainingCategory    @relation(fields: [categoryId], references: [id])
  createdByUserId String?
  createdByUser   User?               @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([categoryId, tipo, ordem])
  @@map("training_contents")
}

enum TechnicalFileType {
  Driver
  Firmware
  Manual
  Utilitario
  Outro
}

enum TechnicalOptionKind {
  Fabricante
  Produto
  SistemaOperacional
}

model TechnicalOption {
  id        String              @id @default(cuid())
  kind      TechnicalOptionKind
  nome      String
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([kind, nome])
  @@index([kind, nome])
  @@map("technical_options")
}

model TechnicalCategory {
  id        String          @id @default(cuid())
  nome      String          @unique
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  files     TechnicalFile[]

  @@map("technical_categories")
}

model TechnicalFile {
  id                 String            @id @default(cuid())
  nome               String
  descricao          String?
  tipo               TechnicalFileType @default(Driver)
  fabricante         String?
  produto            String
  versao             String?
  sistemaOperacional String?
  nomeOriginal       String
  nomeArmazenado     String            @unique
  mimeType           String?
  tamanhoBytes       Int
  categoryId         String
  category           TechnicalCategory @relation(fields: [categoryId], references: [id])
  createdByUserId    String?
  createdByUser      User?             @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([categoryId, tipo])
  @@index([fabricante])
  @@index([produto])
  @@map("technical_files")
}

model UserPresence {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  path      String?
  lastSeen  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lastSeen])
  @@map("user_presences")
}

model QuoteItem {
  id                String        @id @default(cuid())
  quoteId           String
  quote             Quote         @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  ordem             Int
  tipoItem          TipoItem      @default(Produto)
  descricao         String
  observacao        String?
  fotoUrl           String?
  quantidade        Decimal       @db.Decimal(14, 3)
  valorUnitario     Decimal       @db.Decimal(14, 2)
  calcularPorMargem Boolean       @default(false)
  custoUnitario     Decimal?      @db.Decimal(14, 2)
  margemLucro       Decimal?      @db.Decimal(8, 2)
  freteHabilitado   Boolean       @default(false)
  freteUnitario     Decimal?      @db.Decimal(14, 2)
  descontoTipo      DescontoTipo?
  descontoValor     Decimal?      @db.Decimal(14, 2)
  valorTotal        Decimal       @db.Decimal(14, 2)

  @@map("quote_items")
}

model QuoteCounter {
  id      String @id @default("default")
  lastNum Int    @default(0)

  @@map("quote_counter")
}

enum SupplierQuotationType {
  FornecedorUnico
  MultiplosFornecedores
}

enum SupplierQuotationStatus {
  Rascunho
  EmCotacao
  Recebida
  Aprovada
  NaoAprovada
  Finalizada
}

model Supplier {
  id           String   @id @default(cuid())
  razaoSocial  String
  nomeFantasia String?
  cnpjCpf      String?
  telefone     String?
  email        String?
  endereco     String?
  contato      String?
  observacoes  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  primaryQuotations SupplierQuotation[]     @relation("PrimarySupplier")
  quotationItems    SupplierQuotationItem[]

  @@index([razaoSocial])
  @@map("suppliers")
}

model SupplierQuotation {
  id                  String                  @id @default(cuid())
  numero              String                  @unique
  companyId           String?
  company             Company?                @relation(fields: [companyId], references: [id])
  tipo                SupplierQuotationType   @default(FornecedorUnico)
  primarySupplierId   String?
  primarySupplier     Supplier?               @relation("PrimarySupplier", fields: [primarySupplierId], references: [id])
  referencia          String?
  dataCotacao         DateTime                @default(now())
  observacoes         String?
  observacoesInternas String?
  fotosInternas       Json                    @default("[]")
  status              SupplierQuotationStatus @default(EmCotacao)
  total               Decimal                 @default(0) @db.Decimal(14, 2)
  createdByUserId     String?
  createdByUser       User?                   @relation("SupplierQuotationCreatedBy", fields: [createdByUserId], references: [id])
  updatedByUserId     String?
  updatedByUser       User?                   @relation("SupplierQuotationUpdatedBy", fields: [updatedByUserId], references: [id])
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  itens SupplierQuotationItem[]

  @@index([dataCotacao])
  @@index([status])
  @@map("supplier_quotations")
}

model SupplierQuotationItem {
  id               String            @id @default(cuid())
  quotationId      String
  quotation        SupplierQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  supplierId       String
  supplier         Supplier          @relation(fields: [supplierId], references: [id])
  ordem            Int
  codigoProduto    String?
  codigoFornecedor String?
  descricao        String
  fotoUrl          String?
  quantidade       Decimal           @db.Decimal(14, 3)
  valorUnitario    Decimal           @db.Decimal(14, 2)
  observacao       String?
  valorTotal       Decimal           @db.Decimal(14, 2)

  @@index([quotationId, ordem])
  @@index([supplierId])
  @@map("supplier_quotation_items")
}

model SupplierQuotationCounter {
  id      String @id @default("default")
  lastNum Int    @default(0)

  @@map("supplier_quotation_counter")
}

// ==========================================================================
// Módulo: Gestão de Frota
// ==========================================================================

enum Combustivel {
  Gasolina
  Etanol
  Flex
  Diesel
  GNV
  Eletrico
  Hibrido
}

enum SituacaoVeiculo {
  Ativo
  Inativo
  Manutencao
}

enum TipoDocumentoVeiculo {
  CRLV
  Seguro
  IPVA
  Licenciamento
  Outro
}

enum TipoChecklist {
  Diario
  Semanal
  Mensal
}

enum ChecklistItemTipo {
  Pneus
  Freios
  Luzes
  Oleo
  Agua
  Motor
  Suspensao
  Bateria
  Documentacao
  EquipObrigatorio
}

enum ChecklistItemStatus {
  OK
  Atencao
  NecessitaManutencao
}

enum TipoEventoAgenda {
  Manutencao
  TrocaOleo
  Documento
  Checklist
  Outro
}

model Vehicle {
  id                    String          @id @default(cuid())
  fotoUrl               String?
  nome                  String?
  placa                 String          @unique
  marca                 String
  modelo                String
  versao                String?
  ano                   Int
  cor                   String?
  renavam               String?
  chassi                String?
  combustivel           Combustivel     @default(Flex)
  companyId             String
  company               Company         @relation(fields: [companyId], references: [id])
  kmAtual               Int             @default(0)
  situacao              SituacaoVeiculo @default(Ativo)
  categoria             String?
  capacidadeCarga       Int?
  potencia              Int?
  tracao                String?
  oilChangeIntervalKm   Int?
  tipoUso               String?
  valorAquisicao        Decimal?        @db.Decimal(14, 2)
  observacoesAdicionais String?
  dataAquisicao         DateTime?
  observacoes           String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  documentos   VehicleDocument[]
  mileageLogs  MileageLog[]
  oilChanges   OilChange[]
  maintenances Maintenance[]
  checklists   Checklist[]
  fuels        Fuel[]
  eventos      CalendarEvent[]

  @@map("vehicles")
}

model VehicleDocument {
  id             String               @id @default(cuid())
  vehicleId      String
  vehicle        Vehicle              @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  tipo           TipoDocumentoVeiculo @default(Outro)
  arquivoUrl     String?
  /// Histórico de arquivos substituídos: [{ url, substituidaEm }]
  versoes        Json?
  arquivado      Boolean              @default(false)
  dataEmissao    DateTime?
  dataVencimento DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@map("vehicle_documents")
}

model MileageLog {
  id        String   @id @default(cuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  data      DateTime @default(now())
  km        Int
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@map("mileage_logs")
}

model OilChange {
  id             String   @id @default(cuid())
  vehicleId      String
  vehicle        Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  data           DateTime @default(now())
  km             Int
  tipoOleo       String?
  quantidade     Decimal? @db.Decimal(10, 2)
  oficina        String?
  valor          Decimal? @db.Decimal(14, 2)
  observacoes    String?
  kmProximaTroca Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("oil_changes")
}

model Maintenance {
  id                String   @id @default(cuid())
  vehicleId         String
  vehicle           Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  tipo              String
  data              DateTime @default(now())
  oficina           String?
  valor             Decimal? @db.Decimal(14, 2)
  km                Int?
  responsavelUserId String?
  responsavelUser   User?    @relation(fields: [responsavelUserId], references: [id])
  descricao         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("maintenances")
}

model Checklist {
  id          String              @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  tipo        TipoChecklist       @default(Diario)
  data        DateTime            @default(now())
  hora        String?
  km          Int?
  userId      String?
  user        User?               @relation(fields: [userId], references: [id])
  statusGeral ChecklistItemStatus @default(OK)
  observacoes String?
  fotos       String[]            @default([])
  createdAt   DateTime            @default(now())

  itens ChecklistItem[]

  @@map("checklists")
}

model ChecklistItem {
  id          String              @id @default(cuid())
  checklistId String
  checklist   Checklist           @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  item        ChecklistItemTipo
  status      ChecklistItemStatus @default(OK)

  @@map("checklist_items")
}

model Fuel {
  id              String      @id @default(cuid())
  vehicleId       String
  vehicle         Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  data            DateTime    @default(now())
  km              Int?
  litros          Decimal     @db.Decimal(10, 3)
  valorLitro      Decimal     @db.Decimal(10, 3)
  valorTotal      Decimal     @db.Decimal(14, 2)
  posto           String?
  tipoCombustivel Combustivel @default(Flex)
  createdAt       DateTime    @default(now())

  @@map("fuels")
}

model CalendarEvent {
  id        String           @id @default(cuid())
  vehicleId String?
  vehicle   Vehicle?         @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  titulo    String
  data      DateTime
  descricao String?
  tipo      TipoEventoAgenda @default(Outro)
  createdAt DateTime         @default(now())

  @@map("calendar_events")
}

// ==========================================================================
// Fase 3: notificações, auditoria e controle de acesso
// ==========================================================================

model NotificationLog {
  id           String   @id @default(cuid())
  tipo         String
  referencia   String
  destinatario String?
  enviadoEm    DateTime @default(now())

  @@index([tipo, referencia])
  @@map("notification_logs")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  acao       String
  entidade   String
  entidadeId String?
  detalhes   Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([entidade, entidadeId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ==========================================================================
// Configurações do sistema (personalização) — registro único (singleton)
// ==========================================================================

model SystemSettings {
  id                     String   @id @default("default")
  systemName             String?
  logoUrl                String?
  faviconUrl             String?
  primaryColor           String?
  sidebarColor           String?
  buttonColor            String?
  accentColor            String?
  autoLogoutMinutes      Int?
  maintenanceMode        Boolean  @default(false)
  maintenanceMessage     String?
  trainingVideoMaxMb     Int      @default(0)
  trainingDocumentMaxMb  Int      @default(50)
  technicalFileMaxMb     Int      @default(500)
  notificationCargoPrefs Json?
  smtpHost               String?
  smtpPort               Int?
  smtpUser               String?
  smtpPass               String?
  smtpSecure             Boolean?
  smtpAllowInvalidCert   Boolean?
  smtpFrom               String?
  notificationEmails     String?
  notificationDays       String?
  notificationTime       String?
  smtpEnabled            Boolean?
  telegramBotToken       String?
  telegramChatIds        String?
  telegramEnabled        Boolean?
  telegramDays           String?
  telegramTime           String?
  checklistDays          String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("system_settings")
}

// ==========================================================================
// Controle de Estoque — movimentações de produtos com número de série
// ==========================================================================

model StockMovement {
  id              String   @id @default(cuid())
  cod             String
  descricao       String
  qtd             Int      @default(1)
  respRetirada    String
  respEntrega     String?
  data            DateTime
  numeroSerie     String?
  destino         String?
  devolvido       Boolean  @default(false)
  status          String   @default("Pendente")
  observacoes     String?
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([data])
  @@index([cod])
  @@index([numeroSerie])
  @@map("stock_movements")
}
